# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Without these, tools/jira.mjs runs in dry-run: it writes the exact payload it
# would have sent to pipeline/<slug>/jira/ instead of calling Jira. That is a
# supported mode, not a failure.

# Your Jira Cloud site, no trailing slash.
JIRA_BASE_URL=https://your-site.atlassian.net

# The Atlassian account the token belongs to.
JIRA_EMAIL=you@example.com

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Project key issues are created under, e.g. BEEP.
JIRA_PROJECT_KEY=BEEP

# Must match an issue type that exists in the project.
# Run `node tools/jira.mjs verify` to list the valid ones.
JIRA_ISSUE_TYPE=Task
